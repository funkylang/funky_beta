#!/usr/bin/env fkyrun

#
#  constructor
#

$fruit hash_bag("apple" = 2 "banana" = 3)

print! fruit.serialize
println!
print! length_of(fruit)
println!

$empty empty_hash_bag

print! length_of(empty)
println!

println! "----------"

#
#  type function: get, set (replace), delete
#

$missing fruit("pear")

dump! `missing

print! fruit("apple")
println!

!fruit("apple") 10

print! fruit("apple")
println!
print! length_of(fruit)
println!

$no_apple fruit("apple" 0)

print! no_apple.serialize
println!
print! length_of(no_apple)
println!

$still_one no_apple("pear" undefined)

print! length_of(still_one)
println!

println! "----------"

#
#  add: pairs and bare items, negative counts, zero-sum removal
#

$basket empty_hash_bag

add &basket "pear" = 2

add &basket "pear"

add &basket "mango" "apple" = 1

print! basket.serialize
println!
print! length_of(basket)
println!

add &basket "pear" = -3

print! basket.serialize
println!
print! length_of(basket)
println!

println! "----------"

#
#  merge: sums counts, zero-sum removal, originals unchanged
#

$a hash_bag("apple" = 2 "pear" = 5)
$b hash_bag("pear" = 4 "mango" = 6)

$ab merge(a b)

print! ab.serialize
println!
print! length_of(ab)
println!

$c hash_bag("apple" = -2)

$ac merge(a c)

print! ac.serialize
println!
print! length_of(ac)
println!

print! length_of(a)
println!
print! length_of(b)
println!

println! "----------"

#
#  difference: subtracts counts, negative remainders, originals unchanged
#

$shelves empty_hash_bag

!shelves("apple") 3
!shelves("pear") 5
!shelves("banana") 2

$orders empty_hash_bag

!orders("apple") 1
!orders("pear") 5
!orders("mango") 4

$left difference(shelves orders)

print! left.serialize
println!
print! length_of(left)
println!

print! length_of(shelves)
println!
print! length_of(orders)
println!

println! "----------"

#
#  to_hash_bag from a list of key-value pairs
#

$pairs list("x" = 1 "y" = 2)

$list_bag pairs.to_hash_bag

print! list_bag.serialize
println!
print! length_of(list_bag)
println!

println! "----------"

#
#  serialize / deserialize round-trip
#

$text fruit.serialize

$back deserialize(text)

print! back.serialize
println!

println! "----------"

#
#  empty_collection_of, iteration
#

$cleared fruit.empty_collection_of

print! length_of(cleared)
println!

for_each fruit
  : (name count)
    println! name " = " count
    next!
  pass
