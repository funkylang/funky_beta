<require ./data_dialog>

$SELECT_FILE .

$std::select_file: (io id pathname title = "Select File" context = pathname)
  directory io SELECT_FILE SORT pathname tuple(id context title)

$filename_of (!)

$file_selector_data std_types::object
  .filename_of ""

$SELECT_FILE/job_completed: (_id io files context)
  context $_id $pathname $title
  $entries
    map
      files: (file)
	$name name_of(file)
	if
	  file.is_a_directory
	  -> push(name '/')
	  -> name
  register_handlers &io
    OKAY DIALOG_CLOSED = tuple(file_selected context)
  register_handlers &io
    CANCEL DIALOG_CLOSED = tuple(file_selection_aborted context)
  create_dialog &io.window_manager_of file_selector_data title context:
    vertical_group
      CENTER
      label(pathname)
      list_box
	ROWS = 20
	COLUMNS = 60
	entries
	filename_of
	entries
      okay_cancel_group()
  -> io

$file_selected: (io _key data context)
  context $id $pathname $title
  append &pathname filename_of(data)
  deregister_handlers &io OKAY DIALOG_CLOSED
  deregister_handlers &io CANCEL DIALOG_CLOSED
  if
    pathname .has_suffix. '/':
      select_file &io id pathname title
      -> io undefined
    -> io tuple(JOB_COMPLETED id pathname)

$file_selection_aborted: (io _key _data context)
  context $id $pathname $title
  debug::println "file_selection_aborted"
  debug::dump `id `pathname `title `context
  deregister_handlers &io OKAY DIALOG_CLOSED
  deregister_handlers &io CANCEL DIALOG_CLOSED
  -> io tuple(JOB_COMPLETED id undefined)
