<require ./widgets>

$std::create_data_dialog: (wm data)
  $fields data_fields_of(data)
  $possible_field_values possible_values_of(data)
  $widget_options default_value(widget_options_of(data) empty_hash_table)
  initialize_rendering wm:
    !current_dialog_data data
    $widgets
      map
	fields
	: (field)
	  field $name $field_of
	  $possible_values possible_field_values(name)
	  $options default_value(widget_options(name) empty_list)
	  update_if possible_values.is_undefined &possible_values
	    -> possible_values_of(field_of)
	  if
	    field_of(data).is_a_unique_item:
	      list
		label(push(name ':'))
		vertical_group
		  NARROW
		  map
		    possible_values: (value)
		      radio_button
			value.to_string.to_lower_case
			field_of = value
	    :
	      list
		label(push(name ':'))
		list_box
		  options
		  field_of
		  possible_values
    create_dialog wm data name_of(data):
      vertical_group
	CENTER
	table_group
	  widgets
	horizontal_group
	  push_button("Ok" = OKAY)
	  push_button("Cancel" = CANCEL)
