#!/usr/bin/env fkyrun

<require basic/stdlib>

# Print a 2D array as an ASCII table with borders
$print_array: (data)
  $row_count length_of(data 1)
  $column_count length_of(data 2)

  # Build the separator line: + then column_count copies of ---------+
  $separator_line append("+" dup("---------+" column_count))

  println! separator_line

  from_to 1 row_count
    : (row_no)
      print! "|"
      from_to 1 column_count
        : (column_no)
          $value data(row_no column_no)
          print! pad_left(value 9) "|"
          next!
      println!
      println! separator_line
      next!
    pass

# Create a 3x3 array and fill it
$my_array array(3 3)
!my_array(1 1) 1
!my_array(1 2) 23
!my_array(1 3) 456
!my_array(2 1) 78
!my_array(2 2) 901
!my_array(2 3) 2
!my_array(3 1) 3
!my_array(3 2) 4
!my_array(3 3) 5

print_array! my_array
